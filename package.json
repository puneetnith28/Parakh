{
  "name": "parakh-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prove your skills. Back every claim. Open-source, evidence-grounded developer capability assessment.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test:benchmark": "tsx tests/evaluation/generateMetrics.ts",
    "baseline:check": "npm run build && npm test && npm run test:unit && npm run test:integration && npm run test:security",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
