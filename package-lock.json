      "dependencies": {
        "@parakh/contracts": "*"
      }
    },
    "packages/integrations": {
      "name": "@parakh/integrations",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@parakh/contracts": "*"
      }
