# Application Environment Configuration
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Model Provider (Gemma Inference Route)
# Supported providers: google, huggingface, groq, ollama
MODEL_PROVIDER=google
MODEL_NAME=gemma-2-9b-it
MODEL_API_KEY=
MODEL_BASE_URL=

# GitHub API Access (Public repository read-only)
# Optional for development (60 req/hr), recommended for production (5,000 req/hr)
GITHUB_TOKEN=

# MongoDB Atlas Persistence (Phase 7)
# Optional: Parakh runs in in-memory session mode if omitted
MONGODB_URI=
MONGODB_DATABASE=parakh

# Sentry Agent Tracing & Observability (Phase 8)
# Optional: telemetry is disabled if omitted
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Tiger Data / PostgreSQL Hybrid Search (Phase 4 - Optional)
TIGERDATA_DATABASE_URL=

# Temporal Workflow Engine (Phase 8 - Optional)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# SerpApi External Documentation Search (Phase 8 - Optional)
SERPAPI_API_KEY=

# Backboard Developer Memory (Phase 8 - Optional)
BACKBOARD_API_KEY=

# ElevenLabs Audio Summary Narration (Phase 8 - Optional)
ELEVENLABS_API_KEY=

# DigitalOcean Worker Credentials (Phase 8 - Optional)
DIGITALOCEAN_ACCESS_TOKEN=

# Safety Bounds and Resource Caps
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=40
MAX_REPOSITORY_FILES=150
MAX_FILE_BYTES=200000
MAX_ANALYSIS_REQUIREMENTS=40
ANALYSIS_TIMEOUT_SECONDS=120
